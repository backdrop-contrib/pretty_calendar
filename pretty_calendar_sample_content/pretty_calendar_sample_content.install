<?php

/**
 * @file
 * Install, update and uninstall functions for the Pretty Calendar Sample
 * Content module.
 */

/**
 * Implements hook_install().
 */
function pretty_calendar_sample_content_install() {
  _pretty_calendar_sample_content_create_content_type();
  _pretty_calendar_sample_content_create_date_field();
  _pretty_calendar_sample_content_create_nodes();

  $count = count(_pretty_calendar_sample_content_get_event_data());
  backdrop_set_message(t('Pretty Calendar sample content installed: the <em>Event</em> content type and @count sample nodes have been created. To remove them, delete the nodes and content type manually.', array('@count' => $count)));
}

/**
 * Creates the Event content type.
 */
function _pretty_calendar_sample_content_create_content_type() {
  // Do not recreate if it already exists.
  if (node_type_load('event')) {
    return;
  }

  $type = array(
    'type' => 'event',
    'name' => t('Event'),
    'base' => 'node_content',
    'description' => t('Use events to announce gatherings, workshops, celebrations, and other activities.'),
    'custom' => TRUE,
    'modified' => TRUE,
    'locked' => FALSE,
    'settings' => array(
      'promote_enabled' => FALSE,
    ),
  );

  $type = node_type_set_defaults($type);
  node_type_save($type);

  // Add default body field.
  node_add_body_field($type, t('Description'));
}

/**
 * Creates the date field and attaches it to the Event content type.
 */
function _pretty_calendar_sample_content_create_date_field() {
  // Create the field if it does not exist.
  if (!field_info_field('field_event_date')) {
    $field = array(
      'field_name' => 'field_event_date',
      'type' => 'datetime',
      'module' => 'date',
      'cardinality' => 1,
      'settings' => array(
        'granularity' => array(
          'year' => 'year',
          'month' => 'month',
          'day' => 'day',
          'hour' => 'hour',
          'minute' => 'minute',
          'second' => 0,
        ),
        'tz_handling' => 'site',
        'timezone_db' => 'UTC',
        'todate' => '',
        'cache_enabled' => 0,
        'cache_count' => 4,
      ),
    );
    field_create_field($field);
  }

  // Attach the field to the event content type if not already attached.
  if (!field_info_instance('node', 'field_event_date', 'event')) {
    $instance = array(
      'field_name' => 'field_event_date',
      'entity_type' => 'node',
      'bundle' => 'event',
      'label' => t('Event Date'),
      'description' => t('The date and time when the event takes place.'),
      'required' => TRUE,
      'settings' => array(
        'default_value' => 'now',
        'default_value2' => 'same',
      ),
      'widget' => array(
        'type' => 'date_popup',
        'weight' => 1,
        'settings' => array(
          'input_format' => 'm/d/Y - H:i',
          'input_format_custom' => '',
          'increment' => 15,
          'text_parts' => array(),
          'year_range' => '-1:+3',
        ),
      ),
      'display' => array(
        'default' => array(
          'label' => 'above',
          'type' => 'date_default',
          'settings' => array(
            'format_type' => 'long',
            'fromto' => 'both',
            'multiple_number' => '',
            'multiple_from' => '',
            'multiple_to' => '',
          ),
          'weight' => 0,
        ),
        'teaser' => array(
          'label' => 'above',
          'type' => 'date_default',
          'settings' => array(
            'format_type' => 'medium',
            'fromto' => 'both',
            'multiple_number' => '',
            'multiple_from' => '',
            'multiple_to' => '',
          ),
          'weight' => 0,
        ),
      ),
    );
    field_create_instance($instance);
  }
}

/**
 * Creates sample event nodes spread across 12 months.
 *
 * Several dates intentionally have multiple events to demonstrate the
 * calendar's ability to display and link to days with more than one event.
 */
function _pretty_calendar_sample_content_create_nodes() {
  $events = _pretty_calendar_sample_content_get_event_data();

  foreach ($events as $event) {
    $node = new Node(array(
      'type' => 'event',
      'title' => $event['title'],
      'uid' => 1,
      'status' => NODE_PUBLISHED,
      'language' => LANGUAGE_NONE,
    ));

    // Set the body field.
    $node->body[LANGUAGE_NONE][0] = array(
      'value' => $event['body'],
      'summary' => $event['summary'],
      'format' => 'filtered_html',
    );

    // Set the event date field. Datetime fields store as 'YYYY-MM-DD HH:MM:SS'.
    $node->field_event_date[LANGUAGE_NONE][0] = array(
      'value' => $event['date'] . ' ' . $event['time'] . ':00',
      'timezone' => 'America/Chicago',
      'timezone_db' => 'UTC',
      'date_type' => 'datetime',
    );

    node_save($node);
  }
}

